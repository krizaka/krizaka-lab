{
  "name": "krizaka-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Krizaka Lab, the family's lab for UI, motion, Java, AI and data experiments. Not a product and not a package: nothing is published or imported from it.",
  "author": "Krizaka <contact@krizaka.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-lab.git"
  },
  "bugs": {
    "url": "https://github.com/krizaka/krizaka-lab/issues"
  },
  "homepage": "https://lab.krizaka.com/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:demo",
    "build:demo": "vite build --outDir dist-demo && node scripts/generate-routes.mjs",
    "preview": "vite preview --outDir dist-demo",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:gallery": "node scripts/check-gallery.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "lint:workspace": "npx --yes -p @krizaka/config krizaka-workspace-guard",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "lint": "pnpm run format:check"
  },
  "dependencies": {
    "@krizaka/charts": "^0.6.0",
    "@krizaka/fonts": "^0.3.0",
    "@krizaka/i18n": "^0.2.3",
    "@krizaka/icons": "^0.7.0",
    "@krizaka/tailwind": "^3.43.0",
    "@krizaka/tokens": "^3.43.0",
    "@krizaka/ui": "^3.43.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@krizaka/config": "^0.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.60.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  },
  "packageManager": "pnpm@10.34.6"
}
