{
  "name": "@krizaka/motion",
  "version": "1.0.0",
  "private": true,
  "description": "The Krizaka motion lab: experimental generative visuals and the guides of @krizaka/ui's motion. Not a package: nothing is published or imported from it.",
  "author": "Krizaka <contact@krizaka.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-motion.git"
  },
  "bugs": {
    "url": "https://github.com/krizaka/krizaka-motion/issues"
  },
  "homepage": "https://motion.krizaka.com/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:demo",
    "build:demo": "vite build --outDir dist-demo && node scripts/generate-routes.mjs",
    "preview": "vite preview --outDir dist-demo",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:gallery": "node scripts/check-gallery.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "lint:workspace": "npx --yes -p @krizaka/config krizaka-workspace-guard"
  },
  "dependencies": {
    "@krizaka/charts": "^0.6.0",
    "@krizaka/fonts": "^0.3.0",
    "@krizaka/i18n": "^0.2.3",
    "@krizaka/icons": "^0.7.0",
    "@krizaka/tailwind": "^3.43.0",
    "@krizaka/tokens": "^3.43.0",
    "@krizaka/ui": "^3.43.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@10.34.6"
}
