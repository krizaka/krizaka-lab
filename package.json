{
  "name": "@krizaka/motion",
  "version": "1.0.0",
  "private": true,
  "description": "The Krizaka motion lab: experimental generative visuals (canvas demos). Not published: its generic flow ships as @krizaka/ui/engine-flow.",
  "author": "Krizaka <contact@krizaka.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-motion.git"
  },
  "bugs": {
    "url": "https://github.com/krizaka/krizaka-motion/issues"
  },
  "homepage": "https://motion.krizaka.com/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./native": {
      "types": "./dist/native/ReactNativeAdapters.d.ts",
      "import": "./dist/native/index.js",
      "require": "./dist/native/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib && pnpm run build:types && pnpm run build:demo",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build --outDir dist-demo && node scripts/generate-routes.mjs",
    "preview": "vite preview --outDir dist-demo",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:gallery": "node scripts/check-gallery.mjs"
  },
  "dependencies": {
    "@krizaka/charts": "^0.6.0",
    "@krizaka/fonts": "^0.3.0",
    "@krizaka/i18n": "^0.2.3",
    "@krizaka/icons": "^0.7.0",
    "@krizaka/tailwind": "^3.43.0",
    "@krizaka/tokens": "^3.43.0",
    "@krizaka/ui": "^3.43.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "^4.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@10.34.6"
}
